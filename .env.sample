# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cydra_social

# JWT Authentication
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# Option 1: Allow all origins (development only)
# CORS_ORIGINS=*

# Option 2: Comma-separated list
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Option 3: JSON array (recommended for multiple origins)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Social Media OAuth - Facebook/Instagram
# Instagram posting uses Facebook OAuth (Instagram Graph API)
# Get credentials from: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_API_VERSION=v24.0
# Development scopes (available without App Review):
# - email: User's email
# - pages_show_list: List user's Pages
# Note: For POSTING, you need App Review for these permissions:
# - pages_manage_posts (Facebook posting)
# - instagram_content_publish (Instagram posting)
# Alternative for development: Use Graph API Explorer to get test tokens
FACEBOOK_SCOPES=email,pages_show_list

# Social Media OAuth - Twitter/X
# Get credentials from: https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_API_VERSION=2
TWITTER_SCOPES=tweet.read tweet.write users.read offline.access

# Social Media OAuth - LinkedIn
# Get credentials from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_API_VERSION=v2
LINKEDIN_SCOPES=openid profile email w_member_social

# OAuth Configuration
OAUTH_REDIRECT_URI=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Token Encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=tlR1K0VgZKq8ZMJKTnUW5zQiAMlHPeGAPBgz9hG6vqg=
